    { "de": "Die Gebühr beträgt hundert Euro.", "en": "The fee is one hundred euros.", "who": "staff", "level": "B1" },
    { "de": "Wir melden uns schriftlich bei Ihnen.", "en": "We will contact you in writing.", "who": "staff", "level": "B1" },
