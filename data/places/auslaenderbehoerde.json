    { "de": "Haben Sie einen Termin?", "en": "Do you have an appointment?", "who": "staff", "level": "A1" },
    { "de": "Ihre Wartenummer ist die 47.", "en": "Your queue number is 47.", "who": "staff", "level": "A2" },
